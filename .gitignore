# ─────────────────────────────────────────────────────────────
# Deedar — evidence repository
#
# This repo is documentation + visual evidence ONLY.
# Nothing below belongs in it. These rules exist so that a
# stray `git add .` cannot publish material that is withheld
# pending IP review.
# ─────────────────────────────────────────────────────────────

# Model weights & checkpoints — never publish
*.ckpt
*.safetensors
*.pt
*.pth
*.bin
*.onnx
*.h5
checkpoints/
weights/
models/

# Dataset — never publish
dataset/
data/
pairs/
flatlays/
*.tar
*.tar.gz
*.zip
*.parquet
*.npz
*.npy

# Training & pipeline code — withheld pending IP review
train/
training/
pipeline/
synthesis/
worker/
notebooks/
*.ipynb

# Prompts, configs & hyperparameters — withheld
prompts/
configs/
*.prompt
hparams*
sweep*

# Secrets & credentials
*.pem
*.key
secrets*
credentials*
runpod*.json
serviceaccount*.json

# Raw / unreleased person photographs
raw/
unreleased/
private/
originals/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Node
node_modules/
.next/
dist/
build/
*.log
npm-debug.log*

# OS & editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*~
config.bat
